{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/arch_logo.txt",
    "color": {
      "1": "cyan"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": {
        "user": "cyan",
        "at": "white",
        "host": "blue"
      }
    },
    {
      "type": "custom",
      "format": "----------------------------------------"
    },
    {
      "type": "os",
      "key": "󰍹 OS",
      "keyColor": "cyan"
    },
    {
      "type": "kernel",
      "key": "󰒋 Kernel",
      "keyColor": "cyan"
    },
    {
      "type": "packages",
      "key": "󰏖 Pacotes",
      "keyColor": "cyan"
    },
    {
      "type": "shell",
      "key": "󰞷 Shell",
      "keyColor": "cyan"
    },
    {
      "type": "terminal",
      "key": " Terminal",
      "keyColor": "cyan"
    },
    {
      "type": "cpu",
      "key": " CPU",
      "keyColor": "green"
    },
    {
      "type": "gpu",
      "key": "󰢮 GPU",
      "keyColor": "green"
    },
    {
      "type": "memory",
      "key": " RAM",
      "keyColor": "green"
    },
    "break",
    {
      "type": "custom",
      "format": "----------------------------------------"
    },
  ]
}
