{
    "layer": "top",
    "position": "top",
    "height": 36,
    "width": 1800,
    "margin-top": 7,
    "spacing": 0,

"modules-left": [
        "custom/power",
        "niri/workspaces",
	"tray",
	"mpris"
    ],
"modules-center": [
        "clock"
    ],
"modules-right": [
        "pulseaudio",
        "network",
        "cpu",
        "memory",
        "temperature"
    ],

"niri/workspaces": {
        "format": "{icon}",
        "icon-size": 10,
        "format-icons": {
            "1": "一",
            "2": "二",
            "3": "三",
            "4": "四",
            "5": "五",
            "empty": "二"
        }
      },
"tray": {
        "icon-size": 21,
        "spacing": 10
   },

"clock": { 
     "timezone": "Africa/Luanda",
     "format": " {:%H:%M}",
     "format-alt": "{:%A, %d %b %Y — %H:%M:%S}",
     "interval": 10,
     "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
},
    
"mpris": {
    "player": "spotify",
    "format": "{status_icon} {title} - {artist}",
    "format-paused": "{player_icon} {status_icon}",
    "format-stopped": "",
    "player-icons": {
        "default": "▶",
        "spotify": ""
    },
    "status-icons": {
        "paused": "⏸",
        "playing": "▶",
        "stopped": "■"
    },
     "max-length": 25,
     "interval": 1,
     "on-click": "playerctl -p spotify play-pause ",
     "on-click-right": "playerctl -p spotify next",
     "on-scroll-up": "playerctl -p spotify previous",
      "on-scroll-down": "playerctl -p spotify next",
      "tooltip-format": "{title} - {artist} Album: {album}"
},

"cpu": {
             "format": " {usage}%",
             "on-click": "kitty --class htop_float -e htop"
    },
"memory": {
              "format": " {}%",
              "on-click": "kitty --class htop_float -e htop"
    },
"temperature": {
              "critical-threshold": 80,
              "format-icons": [""],
              "format": " {icon} {temperatureC}°C"
    },

"network": {
              "format-wifi": "{icon} ",
              "format-ethernet": "󰈀",
              "format-disconnected": "󰤮",
              "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
              "tooltip-format": "{essid} - {signalStrength}%",
              "on-click": "kitty --class impala_float -e impala"
},

"pulseaudio": {
           "format": "{icon}",
	   "format-icons": ["", "", " "],
           "format-bluetooth": "",
           "format-bluetooth-muted": " {icon} {format_source}"
    },
"custom/media": {
        "format": "{icon} {text}",
        "return-type": "json",
        "max-length": 40,
        "format-icons": {
        "spotify": "",
        "default": "🎜"
        },
        "escape": true,
        "exec": "$HOME/.config/waybar/mediaplayer.py 2> /dev/null" 
    }
}
